{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-handler?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cache/refresh",
      "schedule": "0 1 * * *"
    }
  ]
}
