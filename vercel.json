{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-handler?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cache/refresh",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cache/refresh",
      "schedule": "20 0 * * *"
    }
  ]
}
